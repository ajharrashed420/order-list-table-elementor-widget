<?xml version="1.0"?>
<ruleset name="Order List Table">
	<description>WordPress coding standards with WooCommerce capabilities.</description>
	<file>.</file>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>
</ruleset>
